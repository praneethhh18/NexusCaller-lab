# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# ── Cloud providers (optional; only needed if you select cloud entries) ──
# Groq covers BOTH cloud STT (Whisper) and cloud LLM (Llama / Mixtral / Qwen)
# Get a key (free, no card): https://console.groq.com → API Keys
GROQ_API_KEY=

# ElevenLabs covers cloud TTS. Free tier = 10,000 characters/month.
# Get a key: https://elevenlabs.io → Profile → API Keys
ELEVENLABS_API_KEY=
# Optional: leave blank to use the Rachel default (21m00Tcm4TlvDq8ikWAM)
ELEVENLABS_VOICE_ID=

# ── Local stack ──────────────────────────────────────────────────────────
# Ollama endpoint — defaults to localhost; change if Ollama runs elsewhere
OLLAMA_BASE_URL=http://localhost:11434/v1

# Pipeline defaults (overridden from the UI at runtime)
# Cloud defaults (uncomment to use Groq + ElevenLabs out of the box):
# DEFAULT_STT=groq-whisper-large-v3-turbo
# DEFAULT_LLM=groq-llama-3.1-8b-instant
# DEFAULT_TTS=elevenlabs-flash_v2_5
# Local defaults:
DEFAULT_STT=moonshine-tiny
DEFAULT_LLM=ollama:smollm2:1.7b
DEFAULT_TTS=melotts-en-us

# MeloTTS defaults for the recommended local test combo
MELOTTS_LANGUAGE=EN
MELOTTS_SPEAKER=EN-US
MELOTTS_SPEED=1.0
MELOTTS_DEVICE=auto
MELOTTS_SAMPLE_RATE=24000
HF_HUB_OFFLINE=1
MOONSHINE_STT_TIMEOUT_SEC=15

# Server
HOST=0.0.0.0
PORT=7860
PREWARM_DEFAULTS=1
PREWARM_TTS_SMOKE=1

# Logging
LOG_LEVEL=INFO
