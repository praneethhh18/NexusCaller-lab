# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Every value below is read by voice_agent/server.py or voice_agent/agent.py.

# ── LiveKit Cloud — required for all combos ──────────────────────────────────
# Create a project at https://cloud.livekit.io → Settings → Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxx
LIVEKIT_API_SECRET=your-api-secret

# ── Telephony — SIP trunk IDs ─────────────────────────────────────────────────
# Each provider needs a LiveKit outbound SIP trunk configured in the LiveKit
# dashboard (SIP → Outbound trunks → Create). Paste the ST_xxx trunk ID here.
# Only configure the providers you actually use — the rest show as "not configured"
# in the precall UI and can't be selected.
#
# Step-by-step for each provider is in voice_agent/README.md → Telephony Setup.

# Twilio — already set up if you followed the quick-start.
# Also accepted as LIVEKIT_OUTBOUND_TRUNK_ID (legacy, still works).
LIVEKIT_TRUNK_TWILIO=ST_xxxxxxxxxxxx

# Telnyx — $10 free credit · https://telnyx.com
# 1. Sign up → Mission Control Portal → SIP Connections → Create Credential Connection
# 2. Note the SIP username/password + server: sip.telnyx.com
# 3. LiveKit dashboard → SIP → Outbound trunks → Create → enter Telnyx SIP details
# 4. Paste trunk ID:
LIVEKIT_TRUNK_TELNYX=

# SignalWire — $5 free credit · Twilio-compatible · https://signalwire.com
# 1. Sign up → create a Space → get SIP credentials from your Space settings
# 2. SIP server: your-space.sip.signalwire.com
# 3. LiveKit dashboard → SIP → Outbound trunks → Create → enter SignalWire SIP details
# 4. Paste trunk ID:
LIVEKIT_TRUNK_SIGNALWIRE=

# Exotel — Indian provider · best rates for +91 numbers · https://exotel.com
# 1. Sign up → Dashboard → Developer → SIP Credentials
# 2. SIP server: exotel.com (or their SIP domain from dashboard)
# 3. LiveKit dashboard → SIP → Outbound trunks → Create → enter Exotel SIP details
# 4. Paste trunk ID:
LIVEKIT_TRUNK_EXOTEL=

# Legacy var — kept for backward compatibility, maps to Twilio if LIVEKIT_TRUNK_TWILIO not set
LIVEKIT_OUTBOUND_TRUNK_ID=

# ── Cloud AI providers — Groq ─────────────────────────────────────────────────
# Covers STT (Whisper) + LLM (Llama / GPT-OSS) for combos 1-3.
# Free tier, no monthly cap: https://console.groq.com → API Keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# ── Cloud AI providers — ElevenLabs TTS ──────────────────────────────────────
# Free tier = 10,000 chars/month (~10 min of speech). Used in combos 1 & 2.
# https://elevenlabs.io → Profile → API Keys
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxx
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL   # Sarah (premade). Change to your clone.

# ── Cloud AI providers — Deepgram STT ────────────────────────────────────────
# Best Indian-English transcription. $200 free credit at signup ≈ 776 hours.
# Used in combos 2 & 3. https://console.deepgram.com → API Keys
DEEPGRAM_API_KEY=

# ── Cloud AI providers — Cartesia TTS ────────────────────────────────────────
# Most natural-sounding voice. Free trial credits at signup. Used in combo 3.
# https://play.cartesia.ai → API Keys
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=f786b574-daa5-4673-aa0c-cbe3e8534c02   # change to your voice

# ── Local OSS stack (combo 4) ─────────────────────────────────────────────────
# Ollama endpoint. Default assumes Ollama running on the same machine.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Skip Piper + Whisper prewarm at worker boot (set to 0 only for cloud-only use)
LOCAL_OSS_PREWARM=1

# Override Piper model cache location (default: ~/.cache/nexuscaller-local-models)
# LOCAL_MODEL_CACHE=C:\path\to\your\cache

# ── Voice agent server ────────────────────────────────────────────────────────
VOICE_AGENT_PORT=8765

# Public HTTPS URL exposed by ngrok (optional — only needed to share the cockpit)
PUBLIC_URL=

# Shared secret between nexuscaller-lab and NexusAgent for the voice callback.
# Set the same value in NexusAgent's .env as VOICE_CALLBACK_SECRET.
VOICE_CALLBACK_SECRET=

# LiveKit agent name — must match the agent_name registered in WorkerOptions
LIVEKIT_AGENT_NAME=vox

# Vox's display name on calls (can be overridden per-call from the CRM)
VOX_AGENT_NAME=Vox
